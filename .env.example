# Primary provider (tried first). Groq or xAI/Grok — the key prefix decides which.
GROQ_API_KEY=
# GROK_API_KEY=

# Fallback provider (tried when the primary fails or is rate-limited).
OPENROUTER_API_KEY=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# XAI_MODEL=grok-3-mini
# OPENROUTER_MODEL=openrouter/auto
